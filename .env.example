ADVERTISER_DEPOSIT_WALLET=replace_me
ADVERTISER_DEPOSIT_PRIVATE_KEY=replace_me
SETTLEMENT_PAYOUT_RECIPIENT=replace_me
CAMPAIGN_DEPOSIT_AMOUNT_WEI=replace_me
